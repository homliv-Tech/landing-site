# Public production origin for canonical URLs, social metadata and sitemap (build-time).
SITE_URL=https://homliv.co.in

DATABASE_URL=postgresql://user:password@localhost:5432/homliv
# Use landing_migrations when sharing CRM's database, before the first migration.
# Preserve the existing journal schema for databases already migrated by this app.
DATABASE_MIGRATIONS_SCHEMA=drizzle
CLIENT_IP_HEADER=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Enquiries

# Keep disabled until CRM is deployed. Google Sheets works independently.
CRM_ENQUIRY_ENABLED=false
# Server-only; full HTTPS endpoint and shared secret (at least 32 characters)
CRM_ENQUIRY_URL=
CRM_ENQUIRY_SECRET=
